# ──────────────────────────────────────────────
# AI-Assisted Unit Testing — Environment Config
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env or a real API key.

# ── LLM Provider (OpenAI-compatible endpoint) ──
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# ── Pipeline Settings ──
TESTING_GOAL=decision_coverage
TARGET_COVERAGE=100.0
MAX_FEEDBACK_ITERATIONS=3
SUBPROCESS_TIMEOUT_S=30

# ── Dataset ──
DATASET_NAME=MBPP
RANDOM_SEED=42

# ── Notes ──
# Free API tokens: OpenRouter.ai (free tier), KiloAI, or any OpenAI-compatible provider
# Supported models (examples):
#   openai/gpt-4o-mini          (OpenRouter)
#   google/gemini-flash-1.5     (OpenRouter)
#   meta-llama/llama-3.1-8b-instruct:free  (OpenRouter free tier)
